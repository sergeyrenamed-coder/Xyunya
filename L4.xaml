<Window x:Class="Lab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="700" Width="600">

    <Window.Resources>
        <x:Array x:Key="MyEditingModes" Type="{x:Type InkCanvasEditingMode}">
            <x:Static Member="InkCanvasEditingMode.Select"/>
            <x:Static Member="InkCanvasEditingMode.EraseByPoint"/>
            <x:Static Member="InkCanvasEditingMode.EraseByStroke"/>
        </x:Array>
        <x:Array x:Key="MyDrawingAttributes" Type="{x:Type DrawingAttributes}">
            <DrawingAttributes Color="Red"   Width="3"  Height="3"/>
            <DrawingAttributes Color="Green" Width="10" Height="10"/>
            <DrawingAttributes Color="Blue"  Width="15" Height="15"/>
        </x:Array>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Задание 1 -->
            <Slider x:Name="Slider" Minimum="8" Maximum="30" />
            <TextBlock x:Name="Message"
                       FontSize="{Binding ElementName=Slider, Path=Value}"
                       Text="Пример WPF-приложения для демонстрации привязки данных"/>

            <!-- Задание 2 -->
            <Slider x:Name="Slider1" Minimum="8" Maximum="30" />
            <Slider x:Name="Slider2" Minimum="8" Maximum="30"
                    Value="{Binding ElementName=Slider1, Path=Value}" />
            <TextBox x:Name="t1"
                     Text="{Binding ElementName=Slider1, Path=Value, Mode=TwoWay}" />
            <TextBox x:Name="t2"
                     Text="{Binding ElementName=Slider1, Path=Value, Mode=OneTime}" />

            <!-- Задание 3 -->
            <Slider x:Name="SliderFont" Minimum="8" Maximum="30" />
            <TextBox x:Name="FontSizeBox"
                     Text="{Binding ElementName=SliderFont, Path=Value,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock FontSize="{Binding ElementName=SliderFont, Path=Value}"
                       Text="Пример WPF-приложения для демонстрации привязки данных"/>

            <!-- Задание 4 -->
            <ListBox x:Name="lbEditingModes"
                     ItemsSource="{StaticResource MyEditingModes}"
                     SelectedValue="{Binding ElementName=inkCanvas,
                                             Path=EditingMode,
                                             Mode=TwoWay}" />
            <ListBox x:Name="lbColors"
                     ItemsSource="{StaticResource MyDrawingAttributes}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=Color}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <InkCanvas x:Name="inkCanvas"
                       Width="525" Height="350"
                       EditingMode="{Binding ElementName=lbEditingModes,
                                             Path=SelectedValue}"
                       DefaultDrawingAttributes="{Binding ElementName=lbColors,
                                                          Path=SelectedValue}"/>

        </StackPanel>
    </ScrollViewer>
</Window>
