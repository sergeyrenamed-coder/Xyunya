<Window x:Class="Lab5.Task3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание 3" Height="500" Width="500">
    <Window.Resources>
        <Style TargetType="TextBox" x:Key="BigTextStyle">
            <Setter Property="FontFamily" Value="Verdana" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderBrush" Value="DarkBlue" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Height" Value="45" />
        </Style>
        <Style TargetType="TextBox" x:Key="SmallTextStyle">
            <Setter Property="FontFamily" Value="Verdana" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
        </Style>
        <Style TargetType="Label" x:Key="SectionLabel">
            <Setter Property="FontFamily" Value="Verdana" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="DarkBlue" />
            <Setter Property="Margin" Value="5,10,5,0" />
        </Style>
    </Window.Resources>
    <StackPanel>
        <Label Style="{StaticResource SectionLabel}">Заголовки (крупный шрифт):</Label>
        <TextBox Style="{StaticResource BigTextStyle}" Text="Заголовок 1" />
        <TextBox Style="{StaticResource BigTextStyle}" Text="Заголовок 2" />
        <TextBox Style="{StaticResource BigTextStyle}" Text="Заголовок 3" />

        <Label Style="{StaticResource SectionLabel}">Описания (мелкий шрифт):</Label>
        <TextBox Style="{StaticResource SmallTextStyle}" Text="Описание к пункту 1" />
        <TextBox Style="{StaticResource SmallTextStyle}" Text="Описание к пункту 2" />
        <TextBox Style="{StaticResource SmallTextStyle}" Text="Описание к пункту 3" />
        <TextBox Style="{StaticResource SmallTextStyle}" Text="Описание к пункту 4" />

        <Button Margin="5,15,5,5" Padding="5"
                Background="DarkBlue" Foreground="White"
                FontFamily="Verdana"
                Click="Button_Click">Применить стиль динамически</Button>
    </StackPanel>
</Window>
