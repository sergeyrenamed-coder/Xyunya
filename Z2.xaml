<Window x:Class="Lab3Task2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор" Height="400" Width="500">
    <DockPanel>

        
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    Margin="5" Background="LightGray">

            
            <Label Content="Цвет кисти:" VerticalAlignment="Center"/>
            <ComboBox x:Name="ColorComboBox" Width="100" Margin="5"
                      SelectedIndex="0"
                      SelectionChanged="ColorComboBox_SelectionChanged">
                <ComboBoxItem Content="Красный" Tag="Red"/>
                <ComboBoxItem Content="Зелёный" Tag="Green"/>
                <ComboBoxItem Content="Синий"   Tag="Blue"/>
                <ComboBoxItem Content="Чёрный"  Tag="Black"/>
            </ComboBox>

            
            <Label Content="Размер:" VerticalAlignment="Center"/>
            <Slider x:Name="SizeSlider" Width="100" Margin="5"
                    Minimum="1" Maximum="50" Value="10"
                    VerticalAlignment="Center"/>
            <Label x:Name="SizeLabel" Content="10"
                   VerticalAlignment="Center" Width="30"/>

            
            <Label Content="Режим:" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DrawRadio"
                             Content="Рисование"
                             IsChecked="True" Margin="3"
                             VerticalAlignment="Center"/>
                <RadioButton x:Name="EditRadio"
                             Content="Редактирование"
                             Margin="3" VerticalAlignment="Center"/>
                <RadioButton x:Name="DeleteRadio"
                             Content="Удаление"
                             Margin="3" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        
        <Canvas x:Name="DrawCanvas" Background="White"
                MouseDown="Canvas_MouseDown"
                MouseMove="Canvas_MouseMove"/>
    </DockPanel>
</Window>
